{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ImagesBackupsLogs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/uploads/*",
        "arn:aws:s3:::BUCKET_NAME/backups/*",
        "arn:aws:s3:::BUCKET_NAME/logs/*"
      ]
    },
    {
      "Sid": "ListForSyncAndRestore",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": { "StringLike": { "s3:prefix": ["uploads/*", "backups/*", "logs/*", "backups/", "logs/"] } }
    },
    {
      "Sid": "ReadOwnSettings",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/sns/*"
    }
  ]
}
