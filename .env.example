# 秘密の値の見本。このファイルをコピーして .env という名前にし、値を書き換える。
# .env は git に入れない(秘密鍵やパスワードが入るため)。
# 書かなかった項目は、application.properties の初期値(開発用)が使われる。

# Google ログイン(Google Cloud の「認証情報」で作った OAuth クライアント)。
# 「承認済みのリダイレクト URI」には次の 2 つを登録する:
#   http://localhost:5173/login/oauth2/code/google
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# メール送信(開発中は Mailpit を使うので、書かなくてよい)
#MAIL_HOST=localhost
#MAIL_PORT=1025
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=no-reply@sns.local

# メールの中のリンクに使う、アプリの URL(開発中は書かなくてよい)
#APP_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------
# 公開用(compose.prod.yaml)。公開するサーバーの .env に書く。
# 使い方: docker compose -f compose.prod.yaml up -d --build
# ------------------------------------------------------------------

# 公開するアドレス(例: 52-194-241-136.sslip.io。IP アドレスの . を - に変えて .sslip.io を付けると、ドメインなしで使える)。
# 書いたアドレスで HTTPS の証明書を自動で取得する。手元で試すときは localhost(自分で作った証明書なので、ブラウザの警告が出る)
#SITE_ADDRESS=

# データベースのパスワード。長くて推測できないものにする(例: openssl rand -base64 24)
#DB_PASSWORD=

# メール送信(登録の確認・パスワード再設定に使う)。AWS なら Amazon SES の SMTP の情報。公開用では必須
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=
# 画像・バックアップ・ログを S3 に置くとき(AWS)。バケットは deploy/aws/setup.ps1 で作り、表示された値を書く。
# 認証は EC2 に付けた IAM ロールなので、アクセスキーは書かない
#STORAGE_TYPE=s3
#S3_BUCKET=

# API 仕様書(/swagger-ui.html と /v3/api-docs)を止めたいとき(初期値は有効)。メモリが足りないときなどに
#API_DOCS_ENABLED=false

# Google ログインを使うときは、上の GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET を書き、
# 「承認済みのリダイレクト URI」に https://<SITE_ADDRESS>/login/oauth2/code/google も登録する
